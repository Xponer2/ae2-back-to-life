{
  "multipart": [
    {
      "apply": {
        "model": "ae2:chest/base"
      }
    },
    {
      "when": {
        "lights_on": "false"
      },
      "apply": {
        "model": "ae2:chest/lights_off"
      }
    },
    {
      "when": {
        "lights_on": "true"
      },
      "apply": {
        "model": "ae2:chest/lights_on"
      }
    }
  ]
}
